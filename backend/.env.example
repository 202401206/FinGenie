# Optional local overrides. Start the server from backend/ so .env is found.
FINGENIE_APP_NAME=FinGenie API
FINGENIE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Optional for health; both are required by GET /api/me.
FINGENIE_SUPABASE_URL=
FINGENIE_SUPABASE_PUBLISHABLE_KEY=
# Use sb_publishable_... with the caller's token. No secret/service-role key needed.
