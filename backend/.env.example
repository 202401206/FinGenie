# Optional local overrides. Start the server from backend/ so .env is found.
FINGENIE_APP_NAME=FinGenie API
FINGENIE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Groq LLM Configuration (for AI Summary and Chatbot)
# Get a free API key at https://console.groq.com
FINGENIE_GROQ_API_KEY=
FINGENIE_GROQ_MODEL=llama-3.3-70b-versatile
FINGENIE_GROQ_BASE_URL=https://api.groq.com/openai/v1

# Never copy secret keys to frontend/.env or a VITE_ variable.
